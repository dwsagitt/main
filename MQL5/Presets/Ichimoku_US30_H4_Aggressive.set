InpPullbackTouchTolATR=0.4

InpUseChikouFilter=false
InpUseFutureKumoFilter=true
InpUseKijunFilter=true
InpRequireTKCross=true
InpTKCrossLookback=8
InpStrongTKCrossOnly=false
InpUseSlopeFilter=true
InpSlopeLookback=2
InpRequireKijunSlope=true
InpRequireTenkanSlope=false

InpUseSpreadFilter=true
InpMaxSpreadPoints=120
InpUseSessionFilter=false
InpSessionStartHour=8
InpSessionEndHour=22
InpAvoidFridayClose=true
