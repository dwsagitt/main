; Ichimoku US30 H4 BossaFX - preset AGGRESSIVE (v1.16)
; Profil: TK Cross + Pullback Kijun + Pullback Tenkan + LowerTF Early Entry
; Wszystkie filtry jakosci (Chikou, StrongTKCross, Slope, ADX) WLACZONE.
; Tylko REQUIRE2BARS na momentum osloniony, by wyciszyc szum.
; Cel: 60-100 trades/rok, PF >= 1.3, Win% >= 45, Max DD < 22%
;
; UWAGA: backtest osobny obowiazkowy. Ten preset ma najwiecej okazji
; (i bledow). Nie polaczy sie z malym depozytem przy 1.5% risk.

InpSymbol=
InpMagic=30040026
InpComment=Ichimoku_H4
InpEnforceH4=true

InpTenkan=9
InpKijun=26
InpSenkouB=52
InpChikouShift=26

InpEnableTKCrossEntry=true
InpEnablePullbackEntry=true
InpPullbackOnTenkan=true
InpPullbackOnKijun=true
InpPullbackLookback=6
InpPullbackTouchTolATR=0.30

InpUseADXFilter=true
InpADXTimeframe=16388
InpADXPeriod=14
InpADXMinForPullback=20.0
InpADXMinForTKCross=15.0

InpUseChikouFilter=true
InpUseFutureKumoFilter=true
InpUseKijunFilter=true
InpRequireTKCross=true
InpTKCrossLookback=7
InpStrongTKCrossOnly=true
InpUseSlopeFilter=true
InpSlopeLookback=3
InpRequireKijunSlope=true
InpRequireTenkanSlope=false
InpSlopeMinATRMove=0.10

InpUseSpreadFilter=true
InpMaxSpreadPoints=120
InpUseSessionFilter=false
InpSessionStartHour=8
InpSessionEndHour=22
InpAvoidFridayClose=true
InpFridayCloseHour=20

InpUseAutoLot=true
InpRiskPercent=1.25
InpFixedLot=0.10
InpMaxLot=5.0
InpMinLot=0.0
InpMaxRiskCapEUR=0.0

InpATRTimeframe=16388
InpATRPeriod=14
InpATRMultSL=1.8
InpRR=2.0
InpUseKijunSL=true
InpUseCloudSL=true
InpSLBufferPoints=50
InpMinStopPoints=200

InpUseLowerTF=true
InpLowerTF=16385
InpLowerTFExitOnTKCross=true
InpLowerTFExitLookback=2
InpLowerTFEarlyEntry=true
InpLowerTFEntryLookback=2
InpLowerTFRequireH4Trend=true

InpUseStrongMomentumExit=true
InpMomentumATRMult=1.6
InpMomentumBodyPct=0.55
InpMomentumOnNewBarOnly=true
InpMomentumRequireProfit=true
InpMomentumRequire2Bars=true

InpUseKijunTrailing=true
InpKijunTrailBuffer=80
InpUseTenkanTrailing=true
