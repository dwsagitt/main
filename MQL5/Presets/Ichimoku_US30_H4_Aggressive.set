InpUseAutoLot=true
InpRiskPercent=1.5
InpFixedLot=0.10
InpMaxLot=5.0
InpMinLot=0.0
InpMaxRiskCapEUR=0.0

InpATRTimeframe=16388
InpATRPeriod=14
InpATRMultSL=1.8
InpRR=1.8
InpUseKijunSL=true
InpUseCloudSL=false
InpSLBufferPoints=40
InpMinStopPoints=200

InpUseLowerTF=true
InpLowerTF=16385
InpLowerTFExitOnTKCross=true
InpLowerTFExitLookback=2
InpLowerTFEarlyEntry=true
InpLowerTFEntryLookback=2
