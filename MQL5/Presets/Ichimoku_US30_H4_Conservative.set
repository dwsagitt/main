; Ichimoku US30 H4 BossaFX - preset CONSERVATIVE
; Profil: rzadkie wejscia, wysoka selektywnosc, niski DD
; Cel: PF >= 1.7, Win% 50-60, max DD < 15%
; Uzycie: w Testerze 'Load' -> wybierz ten plik
;
; Format MT5 .set: nazwa=wartosc||start||step||stop||F (F=optymalizacja)

InpSymbol=
InpMagic=30040026
InpComment=Ichimoku_H4

InpTenkan=9
InpKijun=26
InpSenkouB=52
InpChikouShift=26

InpEnableTKCrossEntry=true
InpEnablePullbackEntry=true
InpPullbackOnTenkan=false
InpPullbackOnKijun=true
InpPullbackLookback=4
InpPullbackTouchTolATR=0.2

InpUseChikouFilter=true
InpUseFutureKumoFilter=true
InpUseKijunFilter=true
InpRequireTKCross=true
InpTKCrossLookback=5
InpStrongTKCrossOnly=true
InpUseSlopeFilter=true
InpSlopeLookback=3
InpRequireKijunSlope=true
InpRequireTenkanSlope=false

InpUseSpreadFilter=true
InpMaxSpreadPoints=80
InpUseSessionFilter=false
InpSessionStartHour=8
InpSessionEndHour=22
InpAvoidFridayClose=true
InpFridayCloseHour=20

InpUseAutoLot=true
InpRiskPercent=0.5
InpFixedLot=0.10
InpMaxLot=5.0
InpMinLot=0.0
InpMaxRiskCapEUR=0.0

InpATRTimeframe=16388
InpATRPeriod=14
InpATRMultSL=2.5
InpRR=2.5
InpUseKijunSL=true
InpUseCloudSL=true
InpSLBufferPoints=80
InpMinStopPoints=300

InpUseLowerTF=true
InpLowerTF=16385
InpLowerTFExitOnTKCross=true
InpLowerTFExitLookback=2
InpLowerTFEarlyEntry=false
InpLowerTFEntryLookback=2
InpLowerTFRequireH4Trend=true

InpUseStrongMomentumExit=true
InpMomentumATRMult=1.5
InpMomentumBodyPct=0.55
InpMomentumOnNewBarOnly=true

InpUseKijunTrailing=true
InpKijunTrailBuffer=120
InpUseTenkanTrailing=true
InpTenkanTrailBuffer=70
InpTenkanTrailAfterPartial=true
InpExitOnTKCross=true
InpExitOnCloudBreak=true
InpUseBreakEven=true
InpBreakEvenAtR=0.8
InpBreakEvenOffsetPt=40
InpUsePartialTP=true
InpPartialTPAtR=1.0
InpPartialTPPercent=50.0

InpMaxPositions=1
InpOnePositionPerBar=true
InpAllowHedge=false
InpSlippagePoints=30
InpCooldownBarsAfterLoss=3

InpVerboseDiagnostics=false
InpDrawSignalArrows=false
InpDrawRejectedDots=false
